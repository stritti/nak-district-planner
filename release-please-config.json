{
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "rc",
      "extra-files": [
        {
          "path": "package.json",
          "type": "json",
          "jsonpath": "$.version"
        },
        {
          "path": "services/frontend/package.json",
          "type": "json",
          "jsonpath": "$.version"
        },
        {
          "path": "services/backend/pyproject.toml",
          "type": "toml",
          "jsonpath": "$.project.version"
        },
        {
          "path": "services/backend/uv.lock",
          "type": "toml",
          "jsonpath": "$.package[?(@.name.value=='nak-district-planner-backend')].version"
        }
      ]
    }
  }
}
