# Docker-internal overrides for long-running application containers.
#
# Keep secrets in .env. Docker Compose interpolates the values below from .env
# and passes only the resulting container-specific settings to backend/worker.
DATABASE_URL=postgresql+asyncpg://${APP_DB_USER:?APP_DB_USER must be set in .env}:${APP_DB_PASSWORD:?APP_DB_PASSWORD must be set in .env}@db:5432/${POSTGRES_DB:?POSTGRES_DB must be set in .env}
VALKEY_URL=valkey://valkey:6379/0
