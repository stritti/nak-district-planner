# Docker-internal migration override.
#
# This file is intentionally loaded only by the one-shot migrate service so the
# owner-level database URL is not added to backend/worker runtime configuration.
MIGRATION_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER:?POSTGRES_USER must be set in .env}:${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set in .env}@db:5432/${POSTGRES_DB:?POSTGRES_DB must be set in .env}
