# Keycloak (docker-compose.prod.yml) — copy to .env.keycloak, never commit.
# Loaded only by the keycloak service.

# Temporary bootstrap admin for the master realm. After the first login,
# create a permanent admin user and delete this one (docs/production-compose.md).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Must match POSTGRES_USER / POSTGRES_PASSWORD in .env.keycloak-db
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=replace-with-a-long-random-password
