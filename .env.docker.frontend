# Settings for the frontend nginx container only (no secrets).
#
# Docker Compose interpolates the value from .env; the frontend does not load
# .env itself, so backend secrets never reach the nginx container.
# Peers allowed to set the client IP via X-Forwarded-For (see runbook 1.2).
NGINX_REAL_IP_FROM=${NGINX_REAL_IP_FROM:-127.0.0.1/32 172.16.0.0/12}
