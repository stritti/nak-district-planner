superadmin_usage() {
  cat <<'EOF'
Aufruf: nakctl superadmin <befehl>

Befehle:
  list [--email TEXT]         Superadmins, Bootstrap-Subject und die zuletzt angelegten Benutzer
                              (Kandidaten für set-sub); --email filtert nach E-Mail-Teil
  set-sub <sub>               Bootstrap-Subject auf einen vorhandenen Benutzer setzen und die
                              einmalige Vergabe neu freischalten (Runbook Abschnitt 2.3)

Optionen:
  --dry-run                   nur prüfen und anzeigen
  -y, --yes                   ohne Rückfrage

Die Person muss sich vorher einmal mit dem neuen Konto anmelden, damit ihre sub
existiert. Nach set-sub ab- und wieder anmelden. Gibt es noch einen Superadmin,
ernennt er das neue Konto einfacher in der Benutzerverwaltung.

Beispiele:
  nakctl superadmin list
  nakctl superadmin list --email muster@example.org
  nakctl superadmin set-sub 3f2a9c1e-5b7d-4e8f-9a0b-1c2d3e4f5a6b
EOF
}

superadmin_list() {
  local email=""
  while (($#)); do
    case "$1" in
      --email) require_value "$1" "${2:-}"; email="$2"; shift 2 ;;
      *) die "$EXIT_USAGE" "unbekannte Option für superadmin list: $1" ;;
    esac
  done
  ((${#email} <= 254)) || die "$EXIT_USAGE" "--email ist zu lang"
  # The new account after an IdP or realm change is an ordinary user, so list
  # recent users as candidates; the filter is passed as a psql variable.
  db_psql -P pager=off -v email="$email" <<'SQL'
\echo '== Superadmins =='
SELECT sub, email, created_at FROM users WHERE is_superadmin ORDER BY created_at;
\echo '== Bootstrap-Konfiguration =='
SELECT superadmin_sub, bootstrap_completed_at FROM app_superadmin_config WHERE id = 1;
\echo '== Kandidaten für set-sub (zuletzt angelegte Benutzer) =='
SELECT sub, email, created_at FROM users
WHERE NOT is_superadmin
  AND (:'email' = '' OR strpos(lower(coalesce(email, '')), lower(:'email')) > 0)
ORDER BY created_at DESC LIMIT 10;
SQL
}

superadmin_set_sub() {
  (($# == 1)) || die "$EXIT_USAGE" "superadmin set-sub braucht genau eine sub"
  local sub="$1" count
  [[ "$sub" =~ ^[[:print:]]{1,255}$ ]] || die "$EXIT_USAGE" "ungültige sub"
  count="$(db_psql -tA -v sub="$sub" <<'SQL'
SELECT count(*) FROM users WHERE sub = :'sub';
SQL
)"
  [[ "$count" == 1 ]] || die "$EXIT_USAGE" "kein Benutzer mit dieser sub. Die Person muss sich zuerst einmal anmelden (nakctl superadmin list zeigt vorhandene)."
  info "Bootstrap-Subject wird gesetzt auf: $sub"
  info "bootstrap_completed_at wird zurückgesetzt; beim nächsten Login dieser sub wird sie Superadmin."
  if ((DRY_RUN)); then
    info "--dry-run: nichts geändert."
    return 0
  fi
  confirm "Superadmin-Bootstrap ändern." "ja"
  db_psql -q -v sub="$sub" <<'SQL' || die "$EXIT_ENV" "Aktualisierung fehlgeschlagen"
UPDATE app_superadmin_config SET superadmin_sub = :'sub', bootstrap_completed_at = NULL WHERE id = 1;
SQL
  audit_log "superadmin set-sub"
  ok "Bootstrap-Subject gesetzt. Jetzt ab- und wieder anmelden."
}

cmd_superadmin() {
  local action="${1:-}"
  shift || true
  require_docker
  case "$action" in
    list) superadmin_list "$@" ;;
    set-sub) superadmin_set_sub "$@" ;;
    "" | -h | --help) superadmin_usage ;;
    *) superadmin_usage >&2; exit "$EXIT_USAGE" ;;
  esac
}

# ------------------------------------------------------------------------- cleanup

cleanup_usage() {
  cat <<'EOF'
Aufruf: nakctl cleanup images [optionen]

Entfernt lokale backend- und frontend-Images alter App-Versionen. Behalten werden
APP_VERSION und die gemerkte Vorversion (ohne gemerkte die jüngste andere).
Volumes werden nie gelöscht.

Optionen:
  --dry-run                   nur anzeigen, was entfernt würde
  -y, --yes                   ohne Rückfrage

Beispiele:
  nakctl cleanup images --dry-run
  nakctl cleanup images
EOF
}

cleanup_images() {
  (($# == 0)) || die "$EXIT_USAGE" "cleanup images kennt keine Optionen"
  local registry current previous
  registry="$(image_registry)"
  current="$(env_get APP_VERSION)"
  previous="$(state_get PREVIOUS_VERSION)"
  [[ -n "$current" ]] || die "$EXIT_ENV" "APP_VERSION ist in .env nicht gesetzt"
  local lines=() line repo tag remove=() kept_other=""
  # newest first: decide on the fallback "previous" before listing removals
  mapfile -t lines < <(docker image ls --format '{{.CreatedAt}}|{{.Repository}}|{{.Tag}}' \
    --filter "reference=$registry/backend" --filter "reference=$registry/frontend" | sort -r)
  if [[ -z "$previous" ]]; then
    for line in "${lines[@]}"; do
      tag="${line##*|}"
      if [[ "$tag" != "$current" && "$tag" != "<none>" ]]; then
        kept_other="$tag"
        break
      fi
    done
    previous="$kept_other"
  fi
  for line in "${lines[@]}"; do
    repo="$(cut -d'|' -f2 <<<"$line")"
    tag="${line##*|}"
    [[ "$tag" == "$current" || "$tag" == "$previous" || "$tag" == "<none>" ]] && continue
    remove+=("$repo:$tag")
  done
  info "Behalten: $current${previous:+, $previous}"
  if ((${#remove[@]} == 0)); then
    info "Nichts zu entfernen."
    return 0
  fi
  printf '  entfernen: %s\n' "${remove[@]}"
  if ((DRY_RUN)); then
    info "--dry-run: nichts entfernt."
    return 0
  fi
  confirm "${#remove[@]} Image(s) werden entfernt." "ja"
  docker image rm "${remove[@]}"
  audit_log "cleanup images removed=${#remove[@]}"
  ok "${#remove[@]} Image(s) entfernt."
}

cmd_cleanup() {
  local action="${1:-}"
  shift || true
  case "$action" in
    images) require_docker; cleanup_images "$@" ;;
    "" | -h | --help) cleanup_usage ;;
    *) cleanup_usage >&2; exit "$EXIT_USAGE" ;;
  esac
}

