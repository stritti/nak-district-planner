# Keycloak configuration. Fill in secure secrets before deploying.

# Database Configuration
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=

# Admin Account (change in production!)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Hostname (used for OIDC discovery)
# For local development, this can be localhost
# For production, set to your domain: auth.example.com
KEYCLOAK_HOSTNAME=auth.example.org

# Logging Level (debug, info, warn, error)
KC_LOG_LEVEL=info
